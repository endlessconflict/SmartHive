#!/usr/bin/env python3
"""Change what a simulated node does:  demo-ctl <hornet|shb|varroa|heat|swarm|off|on|reset> <node|all>"""
import json
import sys
import urllib.request

ACTIONS = {"hornet", "shb", "varroa", "heat", "swarm", "off", "on", "reset"}
NODES = ["sim-0001", "sim-0002", "sim-0003", "sim-0004", "sim-0005"]


def main() -> None:
    if len(sys.argv) != 3 or sys.argv[1] not in ACTIONS or (sys.argv[2] not in NODES and sys.argv[2] != "all"):
        sys.exit(__doc__ + "\nnodes: " + " ".join(NODES) + " all")
    for n in NODES if sys.argv[2] == "all" else [sys.argv[2]]:
        req = urllib.request.Request("http://localhost:8090/act", json.dumps({"node": n, "action": sys.argv[1]}).encode(), method="POST")
        urllib.request.urlopen(req, timeout=5).read()
        print(f"{n}: {sys.argv[1]}")


main()
