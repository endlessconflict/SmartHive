{
  "info": {
    "name": "SmartHive API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual tests for the SmartHive API. Set `email` and `password` in the collection variables first (Current value only, so they are never exported). The token renews itself; ids (apiary, hive, alert, image) are saved when created or listed. See backend/postman/README.md."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Logs in by itself when there is no token or it is about to expire (tokens last 15 minutes).",
          "const url = pm.request.url.toString();",
          "const open = ['/auth/', '/device/', '/healthz', '/readyz'].some(p => url.includes(p));",
          "const exp = Number(pm.collectionVariables.get('token_expires_at') || 0);",
          "if (!open && Date.now() > exp - 30000) {",
          "    const email = pm.collectionVariables.get('email');",
          "    const password = pm.collectionVariables.get('password');",
          "    if (!email || !password) {",
          "        console.warn('Set the email and password collection variables to log in automatically');",
          "    } else {",
          "        pm.sendRequest({",
          "            url: pm.collectionVariables.get('baseUrl') + '/api/v1/auth/login',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/json' },",
          "            body: { mode: 'raw', raw: JSON.stringify({ email, password }) },",
          "        }, (err, res) => {",
          "            if (err || res.code !== 200) {",
          "                console.error('auto login failed', err || res.json());",
          "                return;",
          "            }",
          "            const d = res.json();",
          "            pm.collectionVariables.set('token', d.access_token);",
          "            pm.collectionVariables.set('token_expires_at', String(Date.now() + d.expires_in * 1000));",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "node_id",
      "value": "sim-0001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token_expires_at",
      "value": "0"
    },
    {
      "key": "apiary_id",
      "value": ""
    },
    {
      "key": "hive_id",
      "value": ""
    },
    {
      "key": "alert_id",
      "value": ""
    },
    {
      "key": "device_token",
      "value": ""
    },
    {
      "key": "image_id",
      "value": ""
    },
    {
      "key": "image_sha256",
      "value": ""
    }
  ],
