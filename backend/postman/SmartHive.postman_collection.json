            "url": "{{baseUrl}}/device/v1/images",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "meta",
                  "type": "text",
                  "value": "{\"image_id\": \"{{$guid}}\", \"node_id\": \"{{node_id}}\", \"captured_at\": \"{{$isoTimestamp}}\", \"clock_synced\": true, \"reason\": \"periodic\", \"sha256\": \"{{image_sha256}}\", \"objects\": [{\"cls\": \"bee\", \"conf\": 0.91, \"box\": [0.1, 0.2, 0.3, 0.4]}]}"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{device_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Needs `device_token` (folder 4) and the JPEG SHA-256 in `image_sha256` (PowerShell: (Get-FileHash photo.jpg).Hash.ToLower()). Pick the file in the `file` field."
          },
          "event": [
