      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Stores the token in `token`. Postman keeps the refresh_token cookie by itself."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect([200]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "    const d = pm.response.json();",
                  "    pm.collectionVariables.set('token', d.access_token);",
                  "    pm.collectionVariables.set('token_expires_at', String(Date.now() + d.expires_in * 1000));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh (uses the cookie)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "auth": {
