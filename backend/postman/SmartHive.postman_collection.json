                  "    const d = pm.response.json();",
                  "    pm.collectionVariables.set('token', d.access_token);",
                  "    pm.collectionVariables.set('token_expires_at', String(Date.now() + d.expires_in * 1000));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
