# Dummy values for local development. Copy to .env (git-ignored).
SMARTHIVE_DB_URL=postgresql+asyncpg://smarthive:smarthive@localhost:5432/smarthive
SMARTHIVE_MQTT_HOST=localhost
SMARTHIVE_MQTT_PORT=1883
SMARTHIVE_MQTT_USERNAME=
SMARTHIVE_MQTT_PASSWORD=
# Set to a CA certificate path to use TLS (port 8883). The broker in infra/ also wants a client
# certificate whose CN is the MQTT user ("backend"); infra/pki/gen_certs.sh creates one.
SMARTHIVE_MQTT_TLS_CA=
SMARTHIVE_MQTT_TLS_CERT=
SMARTHIVE_MQTT_TLS_KEY=
SMARTHIVE_MQTT_CLIENT_ID=smarthive-ingest
SMARTHIVE_LOG_LEVEL=INFO

# API: a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SMARTHIVE_JWT_SECRET=
# Set to false only for plain-http development without localhost
SMARTHIVE_COOKIE_SECURE=true
