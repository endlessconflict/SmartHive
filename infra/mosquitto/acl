# Topic ACLs. %u is the MQTT username, which for a device is its node_id.
# Anything not listed here is denied.
# Contract: docs/05-backend/04-messaging-contract.md

# devices: only their own topics
pattern write smarthive/v1/nodes/%u/telemetry
pattern write smarthive/v1/nodes/%u/events
pattern write smarthive/v1/nodes/%u/summary
pattern write smarthive/v1/nodes/%u/health
pattern write smarthive/v1/nodes/%u/status
pattern write smarthive/v1/nodes/%u/cmd/ack
pattern read  smarthive/v1/nodes/%u/config
pattern read  smarthive/v1/nodes/%u/cmd

# backend services (ingest, worker, api)
user backend
topic read  smarthive/v1/nodes/+/telemetry
topic read  smarthive/v1/nodes/+/events
topic read  smarthive/v1/nodes/+/summary
topic read  smarthive/v1/nodes/+/health
topic read  smarthive/v1/nodes/+/status
topic read  smarthive/v1/nodes/+/cmd/ack
topic write smarthive/v1/nodes/+/config
topic write smarthive/v1/nodes/+/cmd

# simulator: publishes for fake nodes. MQTT wildcards cannot match a name prefix, so the sim- rule is
# enforced by the ingestor (nodes.is_simulated), not here
user simulator
topic write smarthive/v1/nodes/+/telemetry
topic write smarthive/v1/nodes/+/events
topic write smarthive/v1/nodes/+/summary
topic write smarthive/v1/nodes/+/health
topic write smarthive/v1/nodes/+/status
topic write smarthive/v1/nodes/+/cmd/ack
topic read  smarthive/v1/nodes/+/config
topic read  smarthive/v1/nodes/+/cmd

# compose health check: may subscribe to the broker's own stats and nothing else
user healthcheck
topic read $SYS/broker/uptime
