# Copy to .env and replace the dummy values. Never commit .env.
POSTGRES_PASSWORD=change-me
# Only with docker-compose.neon.yml: Neon's direct connection string, driver and sslmode only, e.g.
# SMARTHIVE_NEON_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# 32+ random characters, e.g. openssl rand -hex 32
SMARTHIVE_JWT_SECRET=change-me-change-me-change-me-change-me
