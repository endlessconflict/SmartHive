{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smarthive/contracts/config.schema.json",
  "title": "Config",
  "description": "Desired configuration, retained (server to node)",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^smarthive\\.config/1\\.[0-9]+$"
    },
    "config_version": {
      "type": "integer",
      "minimum": 0
    },
    "set": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "config_version",
    "set"
  ]
}
