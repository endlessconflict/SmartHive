{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smarthive/contracts/status.schema.json",
  "title": "Status",
  "description": "Retained node presence, also the last will (node to server)",
  "type": "object",
  "properties": {
    "state": {
      "enum": [
        "online",
        "offline"
      ]
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "state"
  ]
}
