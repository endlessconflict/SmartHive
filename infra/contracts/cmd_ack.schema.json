{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smarthive/contracts/cmd_ack.schema.json",
  "title": "CmdAck",
  "description": "Command result (node to server)",
  "type": "object",
  "properties": {
    "cmd_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "result": {
      "enum": [
        "ok",
        "error",
        "expired"
      ]
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "cmd_id",
    "result"
  ]
}
